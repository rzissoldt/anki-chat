# --------------------------------------------------
# CHAT (OpenAI-compatible vLLM endpoint)
# --------------------------------------------------

# Full Chat Completions URL. Inside Docker, use host.docker.internal for
# a model server running on the Docker host.
CHAT_API_URL=http://host.docker.internal:8001/v1/chat/completions
CHAT_MODEL=qwen38-chat
CHAT_API_KEY=
CHAT_ENABLE_THINKING=false
CHAT_MAX_CONTEXT=32768
# Optional custom Authorization header behavior
CHAT_AUTH_HEADER=Authorization
CHAT_AUTH_SCHEME=Bearer

# Model context window size (tokens). Used by the composer context gauge.
# Override in the browser with NEXT_PUBLIC_CHAT_MAX_CONTEXT if needed.
CHAT_MAX_CONTEXT=32768

# --------------------------------------------------
# MCP AGENT (optional, Streamable HTTP)
# --------------------------------------------------

# Must point to a running MCP Streamable HTTP endpoint, typically ending in /mcp.
MCP_SERVER_URL=
MCP_AUTH_TOKEN=
MCP_TIMEOUT_MS=15000
AGENT_MAX_STEPS=10

# --------------------------------------------------
# STT (optional, OpenAI-compatible)
# --------------------------------------------------

# Example for a vLLM-served Whisper endpoint:
# STT_API_URL=http://host.docker.internal:8001/v1/audio/transcriptions
STT_API_URL=
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo
STT_PROTOCOL=openai-compatible

# Optional default language. Leave empty for autodetection.
STT_LANGUAGE=
STT_TIMEOUT_MS=60000
STT_MAX_BYTES=26214400

# --------------------------------------------------
# TTS (optional, OpenAI-compatible)
# --------------------------------------------------

TTS_API_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
TTS_FORMAT=mp3
TTS_PROTOCOL=openai-compatible
TTS_TIMEOUT_MS=60000
TTS_MAX_CHARS=4000

# --------------------------------------------------
# UI
# --------------------------------------------------

NEXT_PUBLIC_APP_NAME=Anki Chat
NEXT_PUBLIC_ENABLE_REASONING=true
NEXT_PUBLIC_ENABLE_TOOL_CALLS=true
NEXT_PUBLIC_ENABLE_STT=true
NEXT_PUBLIC_ENABLE_TTS=true
NEXT_PUBLIC_AUTO_PLAY_TTS=false
# Optional browser override for the context gauge (falls back to CHAT_MAX_CONTEXT).
# NEXT_PUBLIC_CHAT_MAX_CONTEXT=32768
